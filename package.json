{
  "name": "maxpromo-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Maxpromo Digital platform: web, Agent Bureau, internal OS, and the packages they share.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @maxpromo/web",
    "dev:bureau": "npm run dev --workspace @maxpromo/bureau",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:tokens": "node packages/tooling/check-design-tokens.mjs",
    "verify": "npm run check:tokens && npm run typecheck && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=20"
  }
}
