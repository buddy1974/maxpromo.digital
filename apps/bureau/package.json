{
  "name": "@maxpromo/bureau",
  "version": "0.1.0",
  "private": true,
  "description": "agents.maxpromo.digital \u2014 Max Agent Bureau: public offer page and the supervised-agent dashboard.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:seed:demo": "node --env-file=.env.local lib/seed/run-demo-seed.mjs",
    "auth:provision-operator": "node --env-file=.env.local scripts/provision-operator-user.mjs",
    "check:tokens": "node ../../packages/tooling/check-design-tokens.mjs",
    "verify": "npm run check:tokens && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@maxpromo/config": "*",
    "@maxpromo/design-tokens": "*",
    "@maxpromo/ui": "*",
    "@neondatabase/serverless": "^1.0.2",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.38.3",
    "next": "16.1.6",
    "next-auth": "^4.24.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3"
  }
}
