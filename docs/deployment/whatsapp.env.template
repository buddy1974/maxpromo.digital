# WhatsApp gateway — environment (ADR-0019, docs/architecture/whatsapp-gateway.md)
#
# NAMES AND MEANINGS ONLY. Values go into Vercel (Production) as Sensitive variables,
# never into this file, a chat, a commit or a screenshot. Validated at runtime by
# apps/web/lib/channels/config.ts, which fails closed and names variables, never values.
#
# ── receive (all three, or the webhook answers 503) ───────────────────────────
# Meta App Dashboard → App settings → Basic → App secret (32 hex characters).
WHATSAPP_APP_SECRET=
# Generated locally, ≥32 characters (e.g. `openssl rand -hex 24`). Typed once into
# Meta's webhook configuration; only used for the GET handshake.
WHATSAPP_VERIFY_TOKEN=
# WhatsApp Manager → the number → "Phone number ID" (digits). NOT the phone number.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Manager → account overview → "WhatsApp Business Account ID" (digits).
# Optional but recommended: events for any other account are ignored.
WHATSAPP_BUSINESS_ACCOUNT_ID=
#
# ── automate ──────────────────────────────────────────────────────────────────
# off (default) = record only, Marcel answers from the app · shadow = Max drafts,
# nothing is sent · on = Max answers. Change + redeploy to switch.
WHATSAPP_AUTOMATION=off
# Pilot: comma-separated numbers with country code; when set, ONLY these get Max.
WHATSAPP_TEST_ALLOWLIST=
# A chat Marcel took over returns to Max after this many hours of his silence (default 48).
WHATSAPP_HUMAN_IDLE_HOURS=48
# Message text older than this is erased; derived facts stay (default 90).
WHATSAPP_MESSAGE_RETENTION_DAYS=90
# Automated model turns per conversation per Berlin day before handover (default 40).
WHATSAPP_DAILY_MODEL_TURNS=40
# The first words of the Business App's greeting and away messages, separated by ||,
# so their echoes are not mistaken for Marcel typing. Copy them exactly from the app.
WHATSAPP_NATIVE_AUTOREPLY_PREFIXES=
# true while the Business App greeting is switched on (Max then does not greet again).
WHATSAPP_NATIVE_GREETING_ACTIVE=true
# Optional model override; defaults to ANTHROPIC_MODEL, then the platform default.
WHATSAPP_MODEL=
#
# ── send (required when WHATSAPP_AUTOMATION=on) ────────────────────────────────
# A SYSTEM USER token with whatsapp_business_messaging (Business Settings → System users).
# Never a temporary 24-hour token.
WHATSAPP_ACCESS_TOKEN=
# Graph API version; confirm the current one at onboarding (default v25.0).
WHATSAPP_GRAPH_VERSION=v25.0
#
# Not for production: WHATSAPP_GRAPH_BASE_URL exists for the local simulator and is
# refused unless the evidence environment is armed and the address is loopback.
